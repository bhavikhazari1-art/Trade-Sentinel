# ─────────────────────────────────────────────────────────────────────────────
# TradeJournal — Environment Variables
#
# Copy this file to .env.local for local development, or paste these into your
# Vercel project's Environment Variables panel (Settings → Environment Variables).
#
# ALL of these must be set before the app will connect to Firebase.
# Find the values in Firebase Console → Project Settings → Your apps → SDK setup.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Web SDK config ─────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only required if using push notifications via the API server.
# Do NOT deploy these to Vercel (the push API server runs separately).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=
# SESSION_SECRET=
